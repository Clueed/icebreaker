# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# This file is committed, so never put real secrets in it.

# Postgres connection string (Supabase pooler via the Vercel Postgres driver)
POSTGRES_URL="postgres://postgres.[USERNAME]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel"

# Auth.js session secret. Required.
# Generate with: openssl rand -base64 32
# @see https://authjs.dev/reference/core#secret
AUTH_SECRET=""

# Google OAuth client for sign-in. Required.
# @see https://authjs.dev/getting-started/providers/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Key used to encrypt stored SIP passwords (AES) in the database. Required.
# Generate with: openssl rand -base64 32
# Changing it makes existing stored SIP credentials unreadable.
CRYPTO_SECRET=""

# Development only: add a random 100-500ms delay to tRPC calls (true/false)
DEV_ARTIFICIAL_API_DELAY=false
