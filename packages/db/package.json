{
  "name": "@icebreaker/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "default": "./dist/src/schema.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "push": "pnpm with-env drizzle-kit push",
    "studio": "pnpm with-env drizzle-kit studio",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.11.1",
    "@vercel/postgres": "^0.10.0",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.5.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@icebreaker/eslint-config": "workspace:*",
    "@icebreaker/prettier-config": "workspace:*",
    "@icebreaker/tsconfig": "workspace:*",
    "@icebreaker/validators": "workspace:*",
    "@types/crypto-js": "^4.2.2",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "^0.28.1",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@icebreaker/prettier-config"
}
