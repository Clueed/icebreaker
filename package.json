{
  "name": "icebreaker",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:push": "turbo -F @icebreaker/db push",
    "db:studio": "turbo -F @icebreaker/db studio",
    "dev": "turbo watch dev",
    "dev:next": "turbo watch dev -F @icebreaker/nextjs...",
    "localdev": "pnpm -F @icebreaker/localdev services",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "test": "turbo run test",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "ci:fix": "pnpm run typecheck && pnpm run lint:fix && pnpm run format:fix && pnpm run lint:ws -f"
  },
  "devDependencies": {
    "@icebreaker/prettier-config": "workspace:*",
    "@turbo/gen": "^2.11.10",
    "prettier": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vercel": "^39.4.2"
  },
  "prettier": "@icebreaker/prettier-config",
  "pnpm": {
    "patchedDependencies": {
      "@trpc/server@11.0.0-rc.477": "patches/@trpc__server@11.0.0-rc.477.patch"
    }
  }
}
