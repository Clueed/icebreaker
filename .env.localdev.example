# Fully local setup: no Supabase, no Google, no sipgate. See "Local development" in README.md.
#   cp .env.localdev.example .env

# Local Postgres started by `pnpm localdev`, reached through its ws proxy
POSTGRES_URL="postgresql://postgres:postgres@localhost:54322/postgres"
POSTGRES_WS_PROXY="localhost:54330"

AUTH_SECRET="localdev-not-a-secret"
AUTH_TRUST_HOST=true
# "dev sign in" button on /sign-in, logs in as dev@example.com
AUTH_DEV_LOGIN=true
AUTH_ALLOWED_EMAIL_DOMAINS="example.com"
# Unused locally but required by the env schema
GOOGLE_CLIENT_ID="localdev"
GOOGLE_CLIENT_SECRET="localdev"

CRYPTO_SECRET="localdev-not-a-secret"

# Fake PSTN (Asterisk). Log in via the SIP button with dev / dev.
# Opening the app from another machine? Use that hostname here instead of localhost.
NEXT_PUBLIC_SIP_WS_URL="ws://localhost:8088/ws"
NEXT_PUBLIC_SIP_DOMAIN="localhost"
# Asterisk is reachable directly, so skip STUN. An unreachable STUN server
# (e.g. no internet) adds ~5s of ICE gathering before every call starts ringing.
NEXT_PUBLIC_SIP_ICE_SERVERS=""

DEV_ARTIFICIAL_API_DELAY=FALSE
